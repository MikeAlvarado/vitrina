{
  "name": "vitrina",
  "version": "0.3.1",
  "description": "A finite, draggable plane of cut-out objects for React — pan with inertia, discrete zoom, staggered reveal, grid view, detail flight.",
  "license": "MIT",
  "author": "Mike Alvarado",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MikeAlvarado/vitrina.git",
    "directory": "packages/vitrina"
  },
  "homepage": "https://github.com/MikeAlvarado/vitrina#readme",
  "bugs": "https://github.com/MikeAlvarado/vitrina/issues",
  "keywords": [
    "react",
    "gsap",
    "draggable",
    "pan",
    "zoom",
    "gallery",
    "plane",
    "flip"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/base.css",
    "./themes/paper.css": "./dist/paper.css",
    "./themes/void.css": "./dist/void.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsup",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "gsap": ">=3.13",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^30.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
